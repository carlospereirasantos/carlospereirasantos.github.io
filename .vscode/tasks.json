{
  // Runs the static server on its own, for when you want it without a debug
  // session (F5 does not use this task — see launch.json). Stop it from the
  // terminal panel it opens in.
  //
  // The pages fetch their JSON over HTTP and load ES modules, so opening
  // index.html from disk (file://) fails on CORS — it has to be served.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "serve site",
      "detail": "Static server on http://localhost:8080",
      "type": "shell",
      "command": "node",
      "args": [".vscode/serve.mjs", "-p", "8080"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    }
  ]
}
