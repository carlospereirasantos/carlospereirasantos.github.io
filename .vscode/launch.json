{
  // F5 starts the "serve site" task and opens the site in a browser.
  // Stopping the debug session also stops the server.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Serve site (Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:8080/",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "serve site",
      "postDebugTask": "stop serving"
    },
    {
      "name": "Serve site (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8080/",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "serve site",
      "postDebugTask": "stop serving"
    }
  ]
}
