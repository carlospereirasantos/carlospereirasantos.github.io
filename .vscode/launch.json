{
  // F5 runs the static server, waits for it to report its URL, then opens the
  // site. VS Code owns the server process, so stopping the debug session stops
  // the server too — no stale process holding port 8080.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Serve site (Edge)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/serve.mjs",
      "args": ["-p", "8080"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "serverReadyAction": {
        "pattern": "Serving HTTP on (https?://[^ ]+)",
        "uriFormat": "%s",
        "action": "debugWithEdge",
        "webRoot": "${workspaceFolder}",
        "killOnServerStop": true
      }
    },
    {
      "name": "Serve site (Chrome)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/serve.mjs",
      "args": ["-p", "8080"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "serverReadyAction": {
        "pattern": "Serving HTTP on (https?://[^ ]+)",
        "uriFormat": "%s",
        "action": "debugWithChrome",
        "webRoot": "${workspaceFolder}",
        "killOnServerStop": true
      }
    }
  ]
}
