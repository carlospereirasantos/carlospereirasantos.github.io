# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*.swp

# VS Code: keep the shared run configs, ignore personal state
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/serve.mjs

# Design-canvas preview artifact (regenerated on demand)
.thumbnail

# Node, should a build step ever be added
node_modules/
*.log
*.tsbuildinfo

# NOTE: nothing under data/, downloads/ or images/ is ignored — those are the
# site's content, not build output.
