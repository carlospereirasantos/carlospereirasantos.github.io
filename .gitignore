# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*.swp

# VS Code: keep the shared run configs, ignore personal state
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/serve.mjs

# Design-canvas preview artifact (regenerated on demand)
.thumbnail

# Node, should a build step ever be added
node_modules/
*.log
*.tsbuildinfo

# NOTE: .image-slots.state.json is deliberately NOT ignored.
# It holds every project image as base64 and is what the pages render from.
